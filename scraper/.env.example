# Copy this file to ".env" and fill in your real credentials.
# .env is gitignored and must NEVER be committed.

DR_USERNAME=you@example.com
DR_PASSWORD=your-password-here

# Optional overrides
# DR_HEADLESS=true            # set "false" to watch the browser while it runs
# DR_MAX_PAGES=20             # safety cap on how many pages/scrolls to load
# DR_LISTINGS_URL=https://live.dupontregistry.com/listings/sold/filter:sort=bid_high
